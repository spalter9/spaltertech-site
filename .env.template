# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Claude (Anthropic) - powers live-generated homepage pillar copy and
# Spalty's chat replies. Optional: without it, the homepage keeps its
# static fallback copy and Spalty reports itself offline.
ANTHROPIC_API_KEY=

# ElevenLabs - Spalty's voice (your cloned voice model). Both required for
# Spalty to speak; without them, Spalty still chats but stays text-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Payments and tracking
AUTUMN_SECRET_KEY=

# ─── Sovereign Audio Protocol ────────────────────────────────────────────
# Self-hosted forensic separation worker (services/forensics). The API talks
# to this and nothing else; audio never leaves your infrastructure.
# Leave unset to use the default http://127.0.0.1:8770.
DEMIXER_URL=
# Separation on CPU is slow. Raise for long programme on CPU-only hardware.
DEMIXER_TIMEOUT_MS=
