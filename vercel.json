{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build:web",
  "outputDirectory": "packages/web/dist",
  "redirects": [
    { "source": "/ssp-engine", "destination": "/ssp-engine/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ssp-engine/", "destination": "/ssp-engine/index.html" },
    { "source": "/((?!ssp-engine(?:/|$)).*)", "destination": "/index.html" }
  ]
}
